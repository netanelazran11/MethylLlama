    family-names: Yakir
    affiliation: "The Hebrew University of Jerusalem"
  - given-names: Michael M.
    family-names: Danziger
    affiliation: "The Hebrew University of Jerusalem"
references:
  - type: article
    title: "MethylGPT: a foundation model for the DNA methylome"
    authors:
      - family-names: Ying
        given-names: Kejun
    year: 2024
    doi: "10.1101/2024.10.30.621013"
    notes: "Source of the pretraining corpus and CpG panel, and the comparator model."
